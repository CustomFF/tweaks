            "popup_highlight": "#ecebe8",
            "popup_highlight_text": "rgba(33, 33, 33, 1)",

            "ntp_background": "rgba(236, 234, 230, 1)",
            "ntp_text": "rgba(33, 33, 33, 1)",

            "sidebar": "rgba(216, 213, 208, 1)",

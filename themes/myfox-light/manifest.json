{
    "manifest_version": 2,
    "name": "MyFox Light",
    "author": "MyFox",
    "version": "1.0.3",
    "browser_specific_settings": {
        "gecko": {
            "id": "myfox-light-theme@daydve.github.io"
        }
    },
    "theme": {
